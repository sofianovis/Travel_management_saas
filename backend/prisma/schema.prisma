// ----------------------------------------------------
// 2. Customers
// ----------------------------------------------------
model Customer {
  id        String   @id @default(uuid())
  
  // Names
  name            String
  nameLatin       String?
  firstName       String?
  lastName        String?
  firstNameLatin  String?
  lastNameLatin   String?
  
  // Contacts
  phone           String?
  whatsapp        String?
  email           String?
  
  // Classification
  type            String   @default("ط¹ط§ط¯ظٹ")
  tags            String[] @default([])
  joined          DateTime @default(now())

  // Demographics
  gender          String?
  address         String?
  wilaya          String?
  bloodType       String?
  nationality     String?
  dateOfBirth     String?
  placeOfBirth    String?
  nin             String?
  
  // Passport
  passport        String?
  passportIssue   String?
  passportExpiry  String?
  
  // Mahram
  mahramName      String?
  mahramRelation  String?
  
  // Health
  healthIssues    String?
  notes           String?
  
  // Family relationships
  familyId        String?
  familyRelation  String?
  
  // Media (Images as base64 or paths)
  passportImageName String?
  personalPhotoName String?
  personalPhotoData String?
  passportImageData String?
  
  // Follow ups
  followUps         Json?

  financeTransactions FinanceTransaction[]
  pilgrims            Pilgrim[]
  generalBookings   GeneralBooking[]
}

// ----------------------------------------------------
// 3. Umrah & Hajj Packages
// ----------------------------------------------------
model UmrahPackage {
  id            String   @id @default(uuid())
  name          String
  status        String   @default("ط¸â€¦ط¸ظ¾ط·ع¾ط¸ث†ط·آ­") // ط¸â€¦ط¸ظ¾ط·ع¾ط¸ث†ط·آ­, ط¸â€¦ط·ط›ط¸â€‍ط¸â€ڑ, ط¸â€¦ط¸ئ’ط·ع¾ط¸â€¦ط¸â€‍
  flight        String?
  departure     String?  // YYYY-MM-DD
  departureTime String?
  departurePort String?
  returnDate    String?  // YYYY-MM-DD
  returnTime    String?
  arrivalPort   String?
  
  capacity      Int      @default(50)
  
  // Prices
  priceQuad     Float?
  priceTriple   Float?
  priceDouble   Float?
  
  // Costs
  costFlight    Float?
  costHotel     Float?
  costVisa      Float?

  // Hotels & Team
  makkahHotel   String?
  madinahHotel  String?
  guideName     String?

  pilgrims      Pilgrim[]
}

// ----------------------------------------------------
// 4. Pilgrims (Manifest Entries)
// ----------------------------------------------------
model Pilgrim {
  id          String   @id @default(uuid())
  packageId   String
  package     UmrahPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  
  // A pilgrim might be linked to a customer who paid for them
  linkedCustomerId String?
  customer         Customer? @relation(fields: [linkedCustomerId], references: [id])

  name        String
  dateOfBirth String?
  nationality String   @default("ط·آ¬ط·آ²ط·آ§ط·آ¦ط·آ±ط¸ظ¹")
  passport    String?
  
  visaStatus  String   @default("ط·آ¨ط·آ¯ط¸ث†ط¸â€ ") // ط·آ¬ط¸ث†ط·آ§ط·آ² ط¸â€¦ط·آ³ط·ع¾ط¸â€‍ط¸â€¦, ط¸ظ¾ط¸ظ¹ ط·آ§ط¸â€‍ط·آ³ط¸ظ¾ط·آ§ط·آ±ط·آ©, ط·آ¬ط·آ§ط¸â€،ط·آ²ط·آ©
  visaNumber  String?

  roomType    String   @default("quad") // quad, triple, double
  roomNumber  String?
  busNumber   String?

  pricePaid   Float    @default(0)
}

// ----------------------------------------------------
// 5. Finance Transactions
// ----------------------------------------------------
model FinanceTransaction {
  id           String   @id @default(uuid())
  type         String   // دخل, مصروف
  date         String   // YYYY-MM-DD
  category     String   // طيران, عمرة, تشغيلية, موردين...
  amount          Float
    cost            Float    @default(0)
  method       String   @default("Cash")
  status       String   @default("مؤكد")
  ref          String?
  notes        String?
  
  supplierName String?  // Only for expenses
  
  // Only for income (customer payment)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  
  createdAt    DateTime @default(now())
}




// ----------------------------------------------------
// 6. General Bookings (Flights, Hotels, Visas)
// ----------------------------------------------------
model GeneralBooking {
  id             String   @id @default(uuid())
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  customerName   String   
  phone          String?

  type           String   
  destination    String?
  provider       String?  
  date           String?  
  returnDate     String?  
  pnr            String?

  status         String   @default("��� ��������") 
  paymentStatus  String   @default("��� �����") 
  amount         Float    @default(0)
  paidAmount     Float    @default(0)
  cost           Float    @default(0)
  notes          String?
  paymentMethod  String?
  passengers     String?
  attachments    String?

  createdAt      DateTime @default(now())
}
